{
  "version": 1,
  "presets": {
    "minimal-safe": {
      "description": "Daemons nothing in an automation session needs: Siri, Apple Intelligence, Spotlight indexing, photo analysis, widgets, Health/Fitness, Game Center, News/Weather, Apple Watch companion, Screen Time and analytics.",
      "groups": ["siri", "intelligence", "spotlight", "photos", "widgets", "healthkit", "gamecenter", "news-weather", "companion", "screentime", "analytics"]
    },
    "aggressive": {
      "description": "Everything in minimal-safe plus iCloud sync, routine/maps location services, Mail/Calendar/Contacts sync, telephony/messaging, HomeKit and Wallet. Apps that use those frameworks may misbehave.",
      "groups": ["siri", "intelligence", "spotlight", "photos", "widgets", "healthkit", "gamecenter", "news-weather", "companion", "screentime", "analytics", "icloud", "location", "pim", "comms", "homekit"]
    }
  },
  "groups": {
    "siri": "Siri and dictation back ends",
    "intelligence": "Apple Intelligence / on-device model services",
    "spotlight": "Spotlight search and indexing",
    "photos": "Photo library analysis and conversion",
    "widgets": "Widget host and lock-screen widget renderer",
    "healthkit": "Health, Fitness, Activity and Sleep",
    "gamecenter": "Game Center",
    "news-weather": "News and Weather",
    "companion": "Apple Watch companion and pairing",
    "screentime": "Screen Time and Family Sharing",
    "analytics": "Analytics, ads and telemetry",
    "icloud": "iCloud, CloudKit, Safari bookmark and defaults sync",
    "location": "Routine, Maps sync and Find My",
    "pim": "Mail, Calendar, Contacts and Reminders sync",
    "comms": "Telephony, FaceTime, iMessage",
    "homekit": "HomeKit and Wallet"
  },
