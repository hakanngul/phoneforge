    "minimal-safe": {
      "description": "Daemons nothing in an automation session needs: Siri, Apple Intelligence, Spotlight indexing, photo analysis, widgets, Health/Fitness, Game Center, News/Weather, Apple Watch companion, Screen Time, Mail sync agents and analytics.",
      "groups": [
        "siri",
        "intelligence",
        "spotlight",
        "photos",
        "widgets",
        "healthkit",
        "gamecenter",
        "news-weather",
        "companion",
        "screentime",
        "analytics",
        "mail"
      ]
    },
    "aggressive": {
      "description": "Everything in minimal-safe plus iCloud sync, routine/maps location services, Calendar/Contacts/Reminders daemons, telephony/messaging, HomeKit, Wallet and the lock-screen poster host (wallpaper edits stop working). Apps that use those frameworks may misbehave.",
      "groups": [
        "siri",
        "intelligence",
        "spotlight",
        "photos",
        "widgets",
        "healthkit",
        "gamecenter",
        "news-weather",
        "companion",
        "screentime",
        "analytics",
        "mail",
        "icloud",
        "location",
        "pim",
        "comms",
        "homekit",
        "lockscreen"
      ]
    }
  },
  "groups": {
    "siri": "Siri and dictation back ends",
    "intelligence": "Apple Intelligence / on-device model services",
    "spotlight": "Spotlight search and indexing",
    "photos": "Photo library analysis and conversion",
    "widgets": "Widget host and renderer, plus the Calendar app SpringBoard keeps running for its dynamic icon",
    "healthkit": "Health, Fitness, Activity and Sleep",
    "gamecenter": "Game Center",
    "news-weather": "News and Weather",
    "companion": "Apple Watch companion and pairing",
    "screentime": "Screen Time and Family Sharing",
    "analytics": "Analytics, ads and telemetry",
    "icloud": "iCloud, CloudKit, Safari bookmark and defaults sync",
    "location": "Routine, Maps sync and Find My",
    "pim": "Calendar, Contacts, Reminders and Notes daemons (apps using EventKit/Contacts may stall)",
    "comms": "Telephony, FaceTime, iMessage",
    "homekit": "HomeKit and Wallet",
    "lockscreen": "Lock-screen poster host (PosterBoard) and its extensions",
    "mail": "Mail and Safari-bookmark sync agents (no accounts exist on a fresh simulator)"
  },
